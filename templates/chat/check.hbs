<div class="cns5-check {{#if success}}is-success{{else}}is-failure{{/if}} {{#if critical}}is-critical{{/if}}">
    <h4 class="cns5-check__title">{{title}}</h4>
    <p class="cns5-check__subtitle">{{subtitle}}</p>

    <div class="cns5-check__dice">
        <div class="cns5-check__die">
            <span class="cns5-check__die-value">{{roll}}</span>
            <span class="cns5-check__die-label">{{localize "CNS5.Roll.percentilePair"}}</span>
        </div>
        <div class="cns5-check__die">
            <span class="cns5-check__die-value">{{critTotal}}</span>
            <span class="cns5-check__die-label">
                {{localize "CNS5.Roll.critDie"}}{{#if critMod}} ({{cns5Signed critMod}}){{/if}}
            </span>
        </div>
    </div>

    <p class="cns5-check__result">{{resultLabel}} &mdash; {{outcomeLabel}}</p>

    {{#if targetName}}
    <p class="cns5-check__target">
        {{localize "CNS5.Roll.against"}} <strong>{{targetName}}</strong>
        {{#if defence}} &mdash; {{localize (concat "CNS5.Defence." defence.defence)}}
        {{#if defence.skillName}}({{defence.skillName}}) {{/if}}{{defence.roll}} / {{defence.target}}%{{/if}}
        {{#if passiveDefence}} &mdash; {{localize "CNS5.Defence.passive"}}
        {{#if passiveDefence.skillName}}({{passiveDefence.skillName}}){{/if}}
        {{cns5Signed passiveDefence.modifier}}%{{/if}}
    </p>
    {{/if}}
    {{#if asr}}
    <p class="cns5-check__cost">{{localize "CNS5.Roll.asrNote"}} {{asr}}</p>
    {{/if}}
    {{#if defenceFatigue}}
    <p class="cns5-check__cost">
        {{localize "CNS5.Defence.fatigueSpent"}}: {{defenceFatigue}}
    </p>
    {{/if}}
    {{#if exchangeLabel}}
    <p class="cns5-check__exchange">{{exchangeLabel}}</p>
    {{/if}}

    {{#if damage}}
    <p class="cns5-check__damage">
        {{localize "CNS5.Roll.damage"}}: <strong>{{damage}}</strong> {{damageType}}
    </p>
    {{#if split}}
    <ul class="cns5-check__damage-split">
        <li>
            <span>{{localize "CNS5.Damage.blow"}}</span>
            <span>{{blow}}</span>
        </li>
        {{#if absorption}}
        <li>
            <span>{{localize "CNS5.Damage.absorbed"}}</span>
            <span>-{{split.absorbed}}</span>
        </li>
        {{/if}}
        <li>
            <span>{{localize "CNS5.Damage.toFatigue"}}</span>
            <span>{{split.fatigueLost}}</span>
        </li>
        <li>
            <span>{{localize "CNS5.Damage.toBody"}}</span>
            <span>{{split.bodyLost}}</span>
        </li>
        {{#if bonusDamage}}
        <li class="is-critical">
            <span>{{localize "CNS5.Damage.bonus"}}</span>
            <span>{{bonusDamage}}</span>
        </li>
        {{/if}}
    </ul>
    {{#if targetId}}
    <button type="button" class="cns5-check__apply" data-cns5-apply="{{targetId}}"
            data-fatigue="{{split.fatigueLost}}" data-body="{{split.bodyLost}}">
        {{localize "CNS5.Damage.apply"}}
    </button>
    {{/if}}
    {{/if}}
    {{/if}}

    {{#if fumble}}
    <p class="cns5-check__fumble">
        {{localize "CNS5.Roll.fumble"}}
    </p>
    {{/if}}
    {{#if cost}}
    <p class="cns5-check__cost">{{cost}}</p>
    {{/if}}

    {{#if breakdown}}
    <details class="cns5-check__breakdown" data-sync>
        <summary>{{localize "CNS5.Roll.breakdown"}}</summary>
        <ul>
            {{#each breakdown}}
            <li><span>{{label}}</span><span>{{value}}</span></li>
            {{/each}}
            {{#if unclamped}}
            <li class="is-total"><span>{{localize "CNS5.Roll.tsc"}}</span><span>{{unclamped}}%</span></li>
            {{/if}}
        </ul>
        {{#if overflow}}
        <p class="cns5-hint cns5-hint--good">
            {{localize "CNS5.Roll.overflowChat"}} {{overflow}}% &rarr; {{cns5Signed critMod}}
        </p>
        {{/if}}
        {{#if shortfall}}
        <p class="cns5-hint cns5-hint--bad">
            {{localize "CNS5.Roll.shortfallChat"}} {{shortfall}}% &rarr; {{cns5Signed critMod}}
        </p>
        {{/if}}
        {{#if unskilled}}
        <p class="cns5-hint cns5-hint--bad">{{localize "CNS5.Roll.unskilledNote"}}</p>
        {{/if}}
    </details>
    {{/if}}
</div>
