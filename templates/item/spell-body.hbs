<div class="cns5-grid cns5-grid--four">
    <label class="cns5-field">
        <span>{{localize "CNS5.Spell.methodLabel"}}</span>
        <!-- The stored field is named `mode`; it holds a Method. The input
             must address it by its real name, so this one place keeps the old
             word. Everything that reads it uses `method`. -->
        <input type="text" name="system.mode" value="{{system.method}}"
               placeholder="{{localize 'CNS5.Spell.methodPlaceholder'}}"
               {{#unless editable}}disabled{{/unless}}>
    </label>
    <label class="cns5-field">
        <span>{{localize "CNS5.Spell.mr"}}</span>
        <input type="number" name="system.mr" value="{{system.mr}}" min="0"
               {{#unless editable}}disabled{{/unless}}>
    </label>
    <label class="cns5-field">
        <span>{{localize "CNS5.Spell.fpToCast"}}</span>
        <input type="number" name="system.fpToCast" value="{{system.fpToCast}}" min="0"
               {{#unless editable}}disabled{{/unless}}>
    </label>
    <label class="cns5-field">
        <span>{{localize "CNS5.Spell.apToCast"}}</span>
        <input type="number" name="system.apToCast" value="{{system.apToCast}}" min="0"
               {{#unless editable}}disabled{{/unless}}>
    </label>
</div>

<div class="cns5-grid cns5-grid--three">
    <label class="cns5-field">
        <span>{{localize "CNS5.Spell.group"}}</span>
        <input type="text" name="system.group" value="{{system.group}}"
               {{#unless editable}}disabled{{/unless}}>
    </label>
    <label class="cns5-field">
        <span>{{localize "CNS5.Spell.castingTime"}}</span>
        <input type="text" name="system.castingTime" value="{{system.castingTime}}"
               {{#unless editable}}disabled{{/unless}}>
    </label>
    <label class="cns5-field">
        <span>{{localize "CNS5.Spell.duration"}}</span>
        <input type="text" name="system.duration" value="{{system.duration}}"
               {{#unless editable}}disabled{{/unless}}>
    </label>
</div>

<div class="cns5-checks">
    <label class="cns5-checkbox">
        <input type="checkbox" name="system.resisted" {{checked system.resistable}}
               {{#unless editable}}disabled{{/unless}}>
        <span>{{localize "CNS5.Spell.resisted"}}</span>
    </label>
</div>
<p class="cns5-hint">{{localize "CNS5.Spell.resistedHint"}}</p>

<label class="cns5-field">
    <span>{{localize "CNS5.Spell.prerequisite"}}</span>
    <input type="text" name="system.prerequisite" value="{{system.prerequisite}}"
           {{#unless editable}}disabled{{/unless}}>
</label>

{{#if system.mrNote}}
<p class="cns5-hint">{{localize "CNS5.Spell.mrNote"}} <strong>{{system.mrNote}}</strong>. {{localize "CNS5.Spell.variableHint"}}</p>
{{else if system.fatigueNote}}
<p class="cns5-hint">{{localize "CNS5.Spell.fatigueNote"}} <strong>{{system.fatigueNote}}</strong>. {{localize "CNS5.Spell.variableHint"}}</p>
{{/if}}

<fieldset class="cns5-fieldset">
    <legend>{{localize "CNS5.Spell.ranges"}}</legend>
    <label class="cns5-field">
        <span>{{localize "CNS5.Spell.maxRange"}}</span>
        <input type="text" name="system.rangeText" value="{{system.rangeText}}"
               placeholder="10’ x ML" {{#unless editable}}disabled{{/unless}}>
    </label>
    <p class="cns5-hint">{{localize "CNS5.Spell.rangeHint"}}</p>

    {{#if system.rangeLabels}}
    <dl class="cns5-derived">
        <div><dt>{{localize "CNS5.Range.short"}}</dt><dd>{{system.rangeLabels.short}}</dd></div>
        <div><dt>{{localize "CNS5.Range.long"}}</dt><dd>{{system.rangeLabels.long}}</dd></div>
        <div><dt>{{localize "CNS5.Range.max"}}</dt><dd>{{system.rangeLabels.max}}</dd></div>
    </dl>
    {{else if system.parsedRange.unknown}}
    <p class="cns5-hint cns5-hint--bad">
        {{localize "CNS5.Spell.rangeUnknown"}} {{system.parsedRange.unknown}}.
    </p>
    {{else if system.parsedRange.label}}
    <p class="cns5-hint">{{localize system.parsedRange.label}}</p>
    {{/if}}
</fieldset>

<div class="cns5-grid cns5-grid--two">
    <label class="cns5-field">
        <span>{{localize "CNS5.Spell.otherModifier"}}</span>
        <input type="number" name="system.otherModifier" value="{{system.otherModifier}}"
               {{#unless editable}}disabled{{/unless}}>
    </label>
    <label class="cns5-field">
        <span>{{localize "CNS5.Item.reference"}}</span>
        <input type="text" name="system.reference" value="{{system.reference}}"
               {{#unless editable}}disabled{{/unless}}>
    </label>
</div>

{{#if onActor}}
<section class="cns5-readout">
    <h3>{{localize "CNS5.Spell.targeting"}}</h3>
    {{#if system.methodMissing}}
    <p class="cns5-hint cns5-hint--bad">{{localize "CNS5.Spell.methodMissing"}}</p>
    {{else}}
    <dl class="cns5-derived">
        <div>
            <dt>{{localize "CNS5.Spell.baseChance"}}</dt>
            <dd>{{cns5Percent system.baseChance}}</dd>
        </div>
        <div><dt>{{localize "CNS5.Spell.lasts"}}</dt><dd>{{system.durationLabel}}</dd></div>
    </dl>
    <p class="cns5-hint">{{localize "CNS5.Spell.baseChanceHint"}}</p>
    {{/if}}
</section>
{{/if}}
