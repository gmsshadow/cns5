<section class="tab {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">

    <div class="cns5-grid cns5-grid--three">
        <label class="cns5-field">
            <span>{{localize "CNS5.Details.characterType"}}</span>
            <select name="system.details.characterType" {{#unless editable}}disabled{{/unless}}>
                {{#each characterTypes}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>
                {{/each}}
            </select>
        </label>
        <label class="cns5-field">
            <span>{{localize "CNS5.Details.period"}}</span>
            <select name="system.details.period" {{#unless editable}}disabled{{/unless}}>
                {{#each periods}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>
                {{/each}}
            </select>
        </label>
        <label class="cns5-field">
            <span>{{localize "CNS5.Details.birthOmens"}}</span>
            <select name="system.details.birthOmens" {{#unless editable}}disabled{{/unless}}>
                {{#each birthOmens}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>
                {{/each}}
            </select>
        </label>
    </div>

    <div class="cns5-grid cns5-grid--three">
        <label class="cns5-field">
            <span>{{localize "CNS5.Details.gender"}}</span>
            <input type="text" name="system.details.gender" value="{{system.details.gender}}"
                   {{#unless editable}}disabled{{/unless}}>
        </label>
        <label class="cns5-field">
            <span>{{localize "CNS5.Details.nationality"}}</span>
            <input type="text" name="system.details.nationality" value="{{system.details.nationality}}"
                   {{#unless editable}}disabled{{/unless}}>
        </label>
        <label class="cns5-field">
            <span>{{localize "CNS5.Details.starSign"}}</span>
            <input type="text" name="system.details.starSign" value="{{system.details.starSign}}"
                   {{#unless editable}}disabled{{/unless}}>
        </label>
    </div>

    <div class="cns5-grid cns5-grid--three">
        <label class="cns5-field">
            <span>{{localize "CNS5.Details.familyStatus"}}</span>
            <input type="text" name="system.details.familyStatus" value="{{system.details.familyStatus}}"
                   {{#unless editable}}disabled{{/unless}}>
        </label>
        <label class="cns5-field">
            <span>{{localize "CNS5.Details.liege"}}</span>
            <input type="text" name="system.details.liege" value="{{system.details.liege}}"
                   {{#unless editable}}disabled{{/unless}}>
        </label>
        <label class="cns5-field">
            <span>{{localize "CNS5.Details.influenceFactor"}}</span>
            <input type="number" name="system.details.influenceFactor"
                   value="{{system.details.influenceFactor}}" {{#unless editable}}disabled{{/unless}}>
        </label>
    </div>

    <label class="cns5-checkbox">
        <input type="checkbox" name="system.details.gentle" {{checked system.details.gentle}}
               {{#unless editable}}disabled{{/unless}}>
        <span>{{localize "CNS5.Details.gentle"}}</span>
    </label>
    <p class="cns5-hint">{{localize "CNS5.Details.gentleHint"}}</p>

    <dl class="cns5-derived">
        <div><dt>{{localize "CNS5.Derived.magickResistance"}}</dt><dd>{{cns5Percent system.magick.resistance}}</dd></div>
        <div><dt>{{localize "CNS5.Details.attributeMax"}}</dt><dd>{{system.attributeMax}}</dd></div>
    </dl>

    <section class="cns5-skills">
        <h3 class="cns5-skills__heading">
            {{localize "CNS5.Trait.talents"}}
            <button type="button" class="cns5-add" data-action="createItem" data-type="talent">
                {{localize "CNS5.Item.add"}}
            </button>
        </h3>
        {{#if talents.length}}
        <table class="cns5-skills__table">
            <thead>
            <tr>
                <th scope="col" class="cns5-skills__name">{{localize "CNS5.Trait.talents"}}</th>
                <th scope="col">{{localize "CNS5.Trait.rollShort"}}</th>
                <th scope="col">{{localize "CNS5.Trait.costShort"}}</th>
                <th scope="col"><span class="cns5-visually-hidden">{{localize "CNS5.Skill.controls"}}</span></th>
            </tr>
            </thead>
            <tbody>
            {{#each talents as |talent|}}
            <tr class="{{#unless talent.system.aspectAllowed}}is-unskilled{{/unless}}">
                <th scope="row">
                    <button type="button" class="cns5-skills__roll" data-action="editItem"
                            data-item-id="{{talent.id}}">{{talent.name}}</button>
                    {{#if talent.system.wellAspectedOnly}}
                    <span class="cns5-tag" data-tooltip="{{localize 'CNS5.Talent.wellAspectedOnly'}}">W</span>
                    {{/if}}
                    {{#if talent.system.randomOnly}}
                    <span class="cns5-tag cns5-tag--origin"
                          data-tooltip="{{localize 'CNS5.Talent.randomOnlyHint'}}">
                        {{localize "CNS5.Talent.randomOnly"}}
                    </span>
                    {{/if}}
                </th>
                <td class="cns5-skills__readout">{{talent.system.rollLabel}}</td>
                <td class="cns5-skills__readout">
                    {{#if talent.system.pcCost}}{{talent.system.pcCost}}{{else}}—{{/if}}
                </td>
                <td class="cns5-skills__controls">
                    <button type="button" data-action="deleteItem" data-item-id="{{talent.id}}">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                </td>
            </tr>
            {{/each}}
            </tbody>
        </table>
        {{else}}
        <p class="cns5-hint">{{localize "CNS5.Trait.noTalents"}}</p>
        {{/if}}
    </section>

    <section class="cns5-skills">
        <h3 class="cns5-skills__heading">
            {{localize "CNS5.Trait.flaws"}}
            <button type="button" class="cns5-add" data-action="createItem" data-type="flaw">
                {{localize "CNS5.Item.add"}}
            </button>
        </h3>
        {{#if flaws.length}}
        <table class="cns5-skills__table">
            <thead>
            <tr>
                <th scope="col" class="cns5-skills__name">{{localize "CNS5.Trait.flaws"}}</th>
                <th scope="col">{{localize "CNS5.Trait.rollShort"}}</th>
                <th scope="col">{{localize "CNS5.Trait.costShort"}}</th>
                <th scope="col"><span class="cns5-visually-hidden">{{localize "CNS5.Skill.controls"}}</span></th>
            </tr>
            </thead>
            <tbody>
            {{#each flaws as |flaw|}}
            <tr>
                <th scope="row">
                    <button type="button" class="cns5-skills__roll" data-action="editItem"
                            data-item-id="{{flaw.id}}">{{flaw.name}}</button>
                    {{#if flaw.system.isPhobia}}
                    <span class="cns5-tag" data-tooltip="{{flaw.system.fear}}">
                        {{localize (concat "CNS5.Flaw.severity." flaw.system.severity)}}
                    </span>
                    {{/if}}
                </th>
                <td class="cns5-skills__readout">{{flaw.system.rollLabel}}</td>
                <td class="cns5-skills__readout">
                    {{#if flaw.system.pcBonus}}+{{flaw.system.pcBonus}}{{else}}—{{/if}}
                </td>
                <td class="cns5-skills__controls">
                    <button type="button" data-action="deleteItem" data-item-id="{{flaw.id}}">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                </td>
            </tr>
            {{/each}}
            </tbody>
        </table>
        {{else}}
        <p class="cns5-hint">{{localize "CNS5.Trait.noFlaws"}}</p>
        {{/if}}
    </section>

    <dl class="cns5-derived">
        <div><dt>{{localize "CNS5.Trait.pcNet"}}</dt><dd>{{cns5Signed traitPoints}}</dd></div>
    </dl>

    <fieldset class="cns5-fieldset">
        <legend>{{localize "CNS5.Details.biography"}}</legend>
        {{formInput fields.biography value=system.biography enriched=biographyHTML
                    toggled=true disabled=(not editable)}}
    </fieldset>

    <fieldset class="cns5-fieldset">
        <legend>{{localize "CNS5.Details.familyNotes"}}</legend>
        {{formInput fields.details.fields.familyNotes value=system.details.familyNotes
                    enriched=familyNotesHTML toggled=true disabled=(not editable)}}
    </fieldset>

</section>
