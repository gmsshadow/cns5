<div class="cns5-round">
    <h4 class="cns5-round__title">{{localize "CNS5.Combat.poolsTitle"}}</h4>

    <ul class="cns5-round__list">
        {{#each lines}}
        <li class="cns5-round__entry">
            <span class="cns5-round__name">{{name}}</span>
            <span class="cns5-round__total {{#if debt}}is-debt{{/if}}">{{total}}</span>
            <span class="cns5-round__workings">
                {{die}} {{cns5Signed bonus}}{{#if carried}} {{localize "CNS5.Combat.carried"}} {{cns5Signed carried}}{{/if}}
            </span>
        </li>
        {{/each}}
    </ul>
</div>
