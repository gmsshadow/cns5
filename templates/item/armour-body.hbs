<div class="cns5-grid cns5-grid--five">
    <label class="cns5-field">
        <span>{{localize "CNS5.Armour.location"}}</span>
        <select name="system.location" {{#unless editable}}disabled{{/unless}}>
            {{#each armourLocations}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>
            {{/each}}
        </select>
    </label>
    <label class="cns5-field">
        <span>{{localize "CNS5.Armour.weightClass"}}</span>
        <select name="system.weightClass" {{#unless editable}}disabled{{/unless}}>
            {{#each armourWeights}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>
            {{/each}}
        </select>
    </label>
    <label class="cns5-field">
        <span>{{localize "CNS5.Armour.blockBonus"}}</span>
        <input type="number" name="system.blockBonus" value="{{system.blockBonus}}"
               {{#unless editable}}disabled{{/unless}}>
    </label>
    <label class="cns5-field">
        <span>{{localize "CNS5.Armour.defenceWeight"}}</span>
        <input type="text" name="system.defenceWeight" value="{{system.defenceWeight}}"
               {{#unless editable}}disabled{{/unless}}>
    </label>
    <label class="cns5-field">
        <span>{{localize "CNS5.Armour.failureChance"}}</span>
        <input type="number" name="system.failureChance" value="{{system.failureChance}}"
               min="0" max="100" {{#unless editable}}disabled{{/unless}}>
    </label>
    <label class="cns5-field">
        <span>{{localize "CNS5.Armour.fpToWear"}}</span>
        <input type="number" name="system.fpToWear" value="{{system.fpToWear}}"
               {{#unless editable}}disabled{{/unless}}>
    </label>
</div>

<fieldset class="cns5-fieldset">
    <legend>{{localize "CNS5.Armour.absorption"}}</legend>
    <div class="cns5-grid cns5-grid--five">
        {{#each system.absorption as |value key|}}
        <label class="cns5-field">
            <span>{{localize (concat "CNS5.DamageType." key)}}</span>
            <input type="number" name="system.absorption.{{key}}" value="{{value}}" min="0"
                   {{#unless @root.editable}}disabled{{/unless}}>
        </label>
        {{/each}}
    </div>
</fieldset>

<div class="cns5-grid cns5-grid--three">
    <label class="cns5-field">
        <span>{{localize "CNS5.Armour.armourType"}}</span>
        <input type="text" name="system.armourType" value="{{system.armourType}}"
               {{#unless editable}}disabled{{/unless}}>
    </label>
    <label class="cns5-field">
        <span>{{localize "CNS5.Armour.weightModifier"}}</span>
        <input type="number" step="0.5" min="0" name="system.weightModifier"
               value="{{system.weightModifier}}" {{#unless editable}}disabled{{/unless}}>
    </label>
    {{#if onActor}}
    <div class="cns5-field">
        <span>{{localize "CNS5.Armour.wornWeight"}}</span>
        <output>{{system.wornWeight}} lb</output>
    </div>
    {{/if}}
</div>
<p class="cns5-hint">{{localize "CNS5.Armour.weightModifierHint"}}</p>

<div class="cns5-grid cns5-grid--three">
    <label class="cns5-field">
        <span>{{localize "CNS5.Armour.damageTaken"}}</span>
        <input type="number" name="system.damageTaken" value="{{system.damageTaken}}" min="0"
               {{#unless editable}}disabled{{/unless}}>
    </label>
    <div class="cns5-field">
        <span>{{localize "CNS5.Armour.dodgePenalty"}}</span>
        <output>{{cns5Signed system.dodgePenalty}}</output>
    </div>
    <div class="cns5-field">
        <span>{{localize "CNS5.Armour.thiefPenalty"}}</span>
        <output>{{cns5Signed system.thiefPenalty}}</output>
    </div>
</div>
