<div class="cns5-grid cns5-grid--four">
    <label class="cns5-field">
        <span>{{localize "CNS5.Flaw.kindLabel"}}</span>
        <select name="system.kind" {{#unless editable}}disabled{{/unless}}>
            {{#each flawKinds}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>
            {{/each}}
        </select>
    </label>
    <label class="cns5-field">
        <span>{{localize "CNS5.Trait.rollMin"}}</span>
        <input type="number" name="system.roll.min" value="{{system.roll.min}}" min="1"
               {{#unless editable}}disabled{{/unless}}>
    </label>
    <label class="cns5-field">
        <span>{{localize "CNS5.Trait.rollMax"}}</span>
        <input type="number" name="system.roll.max" value="{{system.roll.max}}" min="1"
               {{#unless editable}}disabled{{/unless}}>
    </label>
    <label class="cns5-field">
        <span>{{localize "CNS5.Flaw.pcBonus"}}</span>
        <input type="number" name="system.pcBonus" value="{{system.pcBonus}}" min="0"
               {{#unless editable}}disabled{{/unless}}>
    </label>
</div>

{{#if system.isPhobia}}
<div class="cns5-grid cns5-grid--three">
    <label class="cns5-field">
        <span>{{localize "CNS5.Flaw.severityLabel"}}</span>
        <select name="system.severity" {{#unless editable}}disabled{{/unless}}>
            {{#each phobiaSeverities}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>
            {{/each}}
        </select>
    </label>
    <label class="cns5-field">
        <span>{{localize "CNS5.Flaw.fear"}}</span>
        <input type="text" name="system.fear" value="{{system.fear}}"
               {{#unless editable}}disabled{{/unless}}>
    </label>
    <div class="cns5-field">
        <span>{{localize "CNS5.Flaw.willpower"}}</span>
        <output>{{cns5Signed system.willpowerPenalty}}%</output>
    </div>
</div>
<p class="cns5-hint">{{localize "CNS5.Flaw.phobiaHint"}}</p>
{{/if}}

<label class="cns5-field">
    <span>{{localize "CNS5.Item.reference"}}</span>
    <input type="text" name="system.reference" value="{{system.reference}}"
           {{#unless editable}}disabled{{/unless}}>
</label>

{{#if system.rollsOnAnotherTable}}
<p class="cns5-hint">{{localize "CNS5.Flaw.rollsAgain"}}</p>
{{/if}}
