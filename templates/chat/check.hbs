<div class="cns5-check {{#if success}}is-success{{else}}is-failure{{/if}} {{#if critical}}is-critical{{/if}}">
    <h4 class="cns5-check__title">{{title}}</h4>
    <p class="cns5-check__subtitle">{{subtitle}}</p>

    {{!-- A spell from an item is got out of it before it is aimed, and the two
          are separate rolls with separate failures (p301). Each is named, so a
          card showing two sets of dice says which was which. --}}
    {{#if castingStep}}
    <div class="cns5-check__step {{#if castingStep.success}}is-success{{else}}is-failure{{/if}}">
        <p class="cns5-check__step-heading">{{castingStep.heading}}</p>
        <p class="cns5-check__step-text">
            {{castingStep.text}}{{#if castingStep.rolled}} &mdash;
            <strong>{{castingStep.roll}}</strong> {{localize "CNS5.Step.against"}} {{castingStep.need}}%{{/if}}
            &mdash; <strong>{{castingStep.outcome}}</strong>
        </p>
    </div>
    {{/if}}

    {{!-- Whatever protects the target is targeted first, outermost in, and a
          spell that fails against one goes no further (p298). --}}
    {{#each defenceSteps}}
    <div class="cns5-check__step {{#if success}}is-success{{else}}is-failure{{/if}}">
        <p class="cns5-check__step-heading">{{heading}}</p>
        <p class="cns5-check__step-text">
            {{text}} &mdash; <strong>{{roll}}</strong> {{localize "CNS5.Step.against"}} {{need}}%
            &mdash; <strong>{{outcome}}</strong>
        </p>
        {{#if note}}<p class="cns5-hint">{{note}}</p>{{/if}}
    </div>
    {{/each}}

    {{!-- A non-mage aims a device by Willpower first (p299). It sits between
          casting and targeting, unnumbered, so the three numbered steps mean
          the same on every card. --}}
    {{#if willpowerStep}}
    <div class="cns5-check__step {{#if willpowerStep.success}}is-success{{else}}is-failure{{/if}}">
        <p class="cns5-check__step-heading">{{willpowerStep.heading}}</p>
        <p class="cns5-check__step-text">
            {{willpowerStep.text}} &mdash;
            <strong>{{willpowerStep.roll}}</strong> {{localize "CNS5.Step.against"}} {{willpowerStep.need}}%
            &mdash; <strong>{{willpowerStep.outcome}}</strong>
        </p>
    </div>
    {{/if}}

    {{#if backfireLabel}}
    <p class="cns5-check__backfire">{{backfireLabel}}</p>
    {{/if}}
    {{#if spiritNote}}
    <p class="cns5-check__cost">{{spiritNote}}</p>
    {{/if}}
    {{#if decayMinutes}}
    <p class="cns5-hint">{{localize "CNS5.Spell.decays" duration=durationLabel minutes=decayMinutes}}</p>
    {{/if}}
    {{#if bookNote}}
    <p class="cns5-hint">{{bookNote}}</p>
    {{/if}}

    {{#if targetingHeading}}
    <p class="cns5-check__step-heading">{{targetingHeading}}</p>
    {{/if}}

    <div class="cns5-check__dice">
        <div class="cns5-check__die">
            <span class="cns5-check__die-value">{{roll}}</span>
            <span class="cns5-check__die-label">{{localize "CNS5.Roll.percentilePair"}}</span>
        </div>
        <div class="cns5-check__die">
            <span class="cns5-check__die-value">{{critTotal}}</span>
            <span class="cns5-check__die-label">
                {{localize "CNS5.Roll.critDie"}}{{#if critApplied}} ({{cns5Signed critApplied}}){{/if}}
            </span>
        </div>
    </div>

    <p class="cns5-check__result">{{resultLabel}} &mdash; {{outcomeLabel}}</p>
    {{#if nothingToTarget}}
    <p class="cns5-hint">{{nothingToTarget}}</p>
    {{/if}}

    {{#if shotLabel}}
    <p class="cns5-check__cost">{{shotLabel}}</p>
    {{/if}}
    {{#if targetName}}
    <p class="cns5-check__target">
        {{localize "CNS5.Roll.against"}} <strong>{{targetName}}</strong>
        {{#if defence}} &mdash; {{localize (concat "CNS5.Defence." defence.defence)}}
        {{#if defence.skillName}}({{defence.skillName}}) {{/if}}{{defence.roll}} / {{defence.target}}%{{/if}}
        {{#if passiveDefence}} &mdash; {{localize "CNS5.Defence.passive"}}
        {{#if passiveDefence.skillName}}({{passiveDefence.skillName}}){{/if}}
        {{cns5Signed passiveDefence.modifier}}%{{/if}}
    </p>
    {{/if}}
    {{#if asr}}
    <p class="cns5-check__cost">{{localize "CNS5.Roll.asrNote"}} {{asr}}</p>
    {{/if}}
    {{#if defenceFatigue}}
    <p class="cns5-check__cost">
        {{localize "CNS5.Defence.fatigueSpent"}}: {{defenceFatigue}}
    </p>
    {{/if}}
    {{#if saveLabel}}
    {{#if saveHeading}}<p class="cns5-check__step-heading">{{saveHeading}}</p>{{/if}}
    <p class="cns5-check__exchange">{{saveLabel}}</p>
    {{#if saveCertain}}
    <p class="cns5-hint">{{saveCertain}}</p>
    {{/if}}
    {{else if offersSave}}
    <p class="cns5-hint">{{localize "CNS5.Save.none"}}</p>
    {{/if}}
    {{#if exchangeLabel}}
    <p class="cns5-check__exchange">{{exchangeLabel}}</p>
    {{/if}}

    {{#if damage}}
    <p class="cns5-check__damage">
        {{localize "CNS5.Roll.damage"}}: <strong>{{damage}}</strong> {{damageType}}
    </p>
    {{#if split}}
    <ul class="cns5-check__damage-split">
        <li>
            <span>{{localize "CNS5.Damage.blow"}}</span>
            <span>{{blow}}</span>
        </li>
        {{#if absorption}}
        <li>
            <span>{{localize "CNS5.Damage.absorbed"}}{{#if hitLocationLabel}} ({{hitLocationLabel}}){{/if}}</span>
            <span>-{{split.absorbed}}</span>
        </li>
        {{/if}}
        <li>
            <span>{{localize "CNS5.Damage.toFatigue"}}</span>
            <span>{{split.fatigueLost}}</span>
        </li>
        <li>
            <span>{{localize "CNS5.Damage.toBody"}}</span>
            <span>{{split.bodyLost}}</span>
        </li>
        {{#if split.bypassedFatigue}}
        <li class="is-critical">
            <span>{{localize (concat "CNS5.Damage.bypassed." split.bypassedFatigue)}}</span>
            <span></span>
        </li>
        {{/if}}
        {{#if bonusDamage}}
        <li class="is-critical">
            <span>{{localize "CNS5.Damage.bonus"}}</span>
            <span>{{bonusDamage}}</span>
        </li>
        {{/if}}
    </ul>
    {{#if targetId}}
    <button type="button" class="cns5-check__apply" data-cns5-apply="{{targetId}}"
            data-fatigue="{{split.fatigueLost}}" data-body="{{split.bodyLost}}">
        {{localize "CNS5.Damage.apply"}}
    </button>
    {{/if}}
    {{/if}}
    {{/if}}

    {{#if advantage}}
    <p class="cns5-check__advantage">
        {{localize "CNS5.Advantage.label"}}: {{localize advantage.label}}
        {{#if advantage.bonus}}{{localize "CNS5.Advantage.bonus" bonus=advantage.bonus}}{{/if}}{{#if advantage.cost}}, {{localize "CNS5.Advantage.costs" cost=advantage.cost}}{{/if}}.
    </p>
    {{#if advantage.opposedByStrength}}
    <p class="cns5-hint">{{localize "CNS5.Advantage.disarmNote" penalty=advantage.penalty}}</p>
    {{/if}}
    {{#if advantage.restricted}}
    <p class="cns5-hint">{{localize "CNS5.Advantage.restricted"}}</p>
    {{/if}}
    {{/if}}

    {{#if fumble}}
    <p class="cns5-check__fumble">
        {{localize "CNS5.Roll.fumble"}}
    </p>
    {{/if}}
    {{#if cost}}
    <p class="cns5-check__cost">{{cost}}</p>
    {{/if}}

    {{#if breakdown}}
    <details class="cns5-check__breakdown" data-sync>
        <summary>{{localize "CNS5.Roll.breakdown"}}</summary>
        <ul>
            {{#each breakdown}}
            <li><span>{{label}}</span><span>{{value}}</span></li>
            {{/each}}
            {{#if unclamped}}
            <li class="is-total"><span>{{localize "CNS5.Roll.tsc"}}</span><span>{{unclamped}}%</span></li>
            {{/if}}
        </ul>
        {{#if overflow}}
        <p class="cns5-hint cns5-hint--good">
            {{localize "CNS5.Roll.overflowChat"}} {{overflow}}% &rarr; {{cns5Signed critMod}}
        </p>
        {{/if}}
        {{#if shortfall}}
        <p class="cns5-hint cns5-hint--bad">
            {{localize "CNS5.Roll.shortfallChat"}} {{shortfall}}% &rarr; {{cns5Signed critMod}}
        </p>
        {{/if}}
        {{#if unskilled}}
        <p class="cns5-hint cns5-hint--bad">{{localize "CNS5.Roll.unskilledNote"}}</p>
        {{/if}}

        {{#if critBreakdown}}
        <p class="cns5-check__subheading">{{localize "CNS5.Roll.critDie"}}</p>
        {{#if critNote}}
        <p class="cns5-hint">{{localize critNote}}</p>
        {{/if}}
        <ul>
            {{#each critBreakdown}}
            <li><span>{{label}}</span><span>{{value}}</span></li>
            {{/each}}
            <li class="is-total">
                <span>{{localize "CNS5.Roll.critTotal"}}</span><span>{{critTotal}}</span>
            </li>
        </ul>
        {{/if}}
    </details>
    {{/if}}
</div>
