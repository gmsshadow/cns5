<section class="tab {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">

    <div class="cns5-grid cns5-grid--three">
        <label class="cns5-field">
            <span>{{localize "CNS5.Magick.tradition"}}</span>
            <select name="system.magick.tradition" {{#unless editable}}disabled{{/unless}}>
                {{#each traditions}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>
                {{/each}}
            </select>
        </label>
        <label class="cns5-field">
            <span>{{localize "CNS5.Magick.mode"}}</span>
            <input type="text" name="system.magick.mode" value="{{system.magick.mode}}"
                   placeholder="{{localize 'CNS5.Magick.modePlaceholder'}}"
                   {{#unless editable}}disabled{{/unless}}>
        </label>
        <label class="cns5-field">
            <span>{{localize "CNS5.Magick.pmfOverride"}}</span>
            <input type="number" name="system.magick.pmfOverride" value="{{system.magick.pmfOverride}}"
                   {{#unless editable}}disabled{{/unless}}>
        </label>
    </div>

    {{#if system.magick.modeMissing}}
    <p class="cns5-hint cns5-hint--bad">{{localize "CNS5.Magick.modeMissing"}}</p>
    {{/if}}

    <dl class="cns5-derived">
        <div><dt>{{localize "CNS5.Magick.pmf"}}</dt><dd>{{system.magick.pmf}}</dd></div>
        <div><dt>{{localize "CNS5.Magick.aspectBonus"}}</dt><dd>{{cns5Signed system.magick.aspectBonus}}</dd></div>
        <div><dt>{{localize "CNS5.Derived.magickLevel"}}</dt><dd>{{system.magick.level}}</dd></div>
        <div><dt>{{localize "CNS5.Derived.magickResistance"}}</dt><dd>{{cns5Percent system.magick.resistance}}</dd></div>
        <div><dt>{{localize "CNS5.Magick.startingMR"}}</dt><dd>{{system.magick.startingMR}}</dd></div>
        <div><dt>{{localize "CNS5.Magick.spentMR"}}</dt><dd>{{spentMR}}</dd></div>
    </dl>

    <section class="cns5-skills">
        <h3 class="cns5-skills__heading">
            {{localize "CNS5.Magick.grimoire"}}
            <button type="button" class="cns5-add" data-action="createItem" data-type="spell">
                {{localize "CNS5.Item.addSpell"}}
            </button>
        </h3>
        {{#if spells.length}}
        <table class="cns5-skills__table">
            <thead>
            <tr>
                <th scope="col" class="cns5-skills__name">{{localize "CNS5.Spell.spell"}}</th>
                <th scope="col">{{localize "CNS5.Spell.mrShort"}}</th>
                <th scope="col">{{localize "CNS5.Spell.fpShort"}}</th>
                <th scope="col">{{localize "CNS5.Spell.apShort"}}</th>
                <th scope="col">{{localize "CNS5.Skill.tscShort"}}</th>
                <th scope="col">{{localize "CNS5.Spell.reach"}}</th>
                <th scope="col">{{localize "CNS5.Spell.lasts"}}</th>
                <th scope="col"><span class="cns5-visually-hidden">{{localize "CNS5.Skill.controls"}}</span></th>
            </tr>
            </thead>
            <tbody>
            {{#each spells as |spell|}}
            <tr class="{{#if spell.system.methodMissing}}is-unskilled{{/if}}">
                <th scope="row">
                    <button type="button" class="cns5-skills__roll" data-action="rollSpell"
                            data-item-id="{{spell.id}}"
                            data-tooltip="{{localize 'CNS5.Roll.spellTooltip'}}">{{spell.name}}</button>
                    {{#if spell.system.resistable}}
                    <span class="cns5-tag" data-tooltip="{{localize 'CNS5.Save.offered'}}">
                        {{localize "CNS5.Save.label"}}
                    </span>
                    {{/if}}
                </th>
                <td class="cns5-skills__readout">{{spell.system.mr}}</td>
                <td class="cns5-skills__readout">{{spell.system.fpToCast}}</td>
                <td class="cns5-skills__readout">{{spell.system.apToCast}}</td>
                <td class="cns5-skills__readout cns5-skills__readout--total"
                    data-tooltip="{{localize 'CNS5.Spell.baseChanceHint'}}">
                    {{cns5Percent spell.system.baseChance}}
                </td>
                <td class="cns5-skills__readout">
                    {{#if spell.system.rangeLabels}}{{spell.system.rangeLabels.max}}
                    {{else}}{{spell.system.rangeText}}{{/if}}
                </td>
                <td class="cns5-skills__readout">{{spell.system.durationLabel}}</td>
                <td class="cns5-skills__controls">
                    <button type="button" data-action="editItem" data-item-id="{{spell.id}}"
                            data-tooltip="{{localize 'CNS5.Item.edit'}}">
                        <i class="fa-solid fa-pen-to-square"></i>
                    </button>
                    <button type="button" data-action="deleteItem" data-item-id="{{spell.id}}"
                            data-tooltip="{{localize 'CNS5.Item.delete'}}">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                </td>
            </tr>
            {{/each}}
            </tbody>
        </table>
        {{else}}
        <p class="cns5-hint">{{localize "CNS5.Magick.empty"}}</p>
        {{/if}}
    </section>

    <section class="cns5-skills">
        <h3 class="cns5-skills__heading">
            {{localize "CNS5.Magickal.heading"}}
            <button type="button" class="cns5-add" data-action="createItem" data-type="magickalItem">
                {{localize "CNS5.Item.add"}}
            </button>
        </h3>
        {{#if magickalItems.length}}
        <table class="cns5-skills__table">
            <thead>
            <tr>
                <th scope="col" class="cns5-skills__name">{{localize "CNS5.Magickal.heading"}}</th>
                <th scope="col">{{localize "CNS5.Magickal.grade"}}</th>
                <th scope="col">{{localize "CNS5.Magickal.charges"}}</th>
                <th scope="col"><span class="cns5-visually-hidden">{{localize "CNS5.Skill.controls"}}</span></th>
            </tr>
            </thead>
            <tbody>
            {{#each magickalItems as |thing|}}
            <tr class="{{#if thing.system.spent}}is-unskilled{{/if}}">
                <th scope="row">
                    <button type="button" class="cns5-skills__roll" data-action="editItem"
                            data-item-id="{{thing.id}}"
                            data-tooltip="{{localize 'CNS5.Item.edit'}}">{{thing.name}}</button>
                    <span class="cns5-tag cns5-tag--origin">
                        {{#if (eq thing.system.kind "focus")}}{{localize "CNS5.Magickal.focus"}}{{else}}{{localize "CNS5.Magickal.device"}}{{/if}}
                    </span>
                </th>
                <td class="cns5-skills__readout">{{localize thing.system.gradeLabel}}</td>
                <td class="cns5-skills__readout cns5-skills__readout--total">
                    {{thing.system.charges}} / {{thing.system.maxCharges}}
                </td>
                <td class="cns5-skills__controls">
                    <button type="button" data-action="editItem" data-item-id="{{thing.id}}"
                            data-tooltip="{{localize 'CNS5.Item.edit'}}">
                        <i class="fa-solid fa-pen-to-square"></i>
                    </button>
                    <button type="button" data-action="deleteItem" data-item-id="{{thing.id}}"
                            data-tooltip="{{localize 'CNS5.Item.delete'}}">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                </td>
            </tr>
            {{/each}}
            </tbody>
        </table>
        {{else}}
        <p class="cns5-hint">{{localize "CNS5.Magickal.none"}}</p>
        {{/if}}
    </section>

</section>
